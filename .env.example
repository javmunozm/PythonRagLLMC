# Copia este archivo como .env y deja activa UNA sola opción (A, B o C).
# .env.example SÍ se sube a Git; .env NO (tiene tus claves).
# --- Opción A: OpenAI directo ---
#LLM_PROVIDER=openai
#OPENAI_API_KEY=
#LLM_MODEL=gpt-5.4-mini
#EMBEDDING_MODEL=text-embedding-3-small
# --- Opción B: Azure OpenAI (API v1): igual que A, más la URL de tu recurso
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<clave de Azure>
# OPENAI_BASE_URL=https://<tu-recurso>.openai.azure.com/openai/v1/
# LLM_MODEL=<nombre de tu deployment de chat>
# EMBEDDING_MODEL=<nombre de tu deployment de embeddings>
# --- Opción C: Gemini (motor de referencia del curso) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# Precio del modelo en USD por millón de tokens (para calcular el costo de cada petición)
PRICE_INPUT_PER_MTOK=0.75
PRICE_OUTPUT_PER_MTOK=4.50
CHROMA_DIR=chroma_db
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10